<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SBC Repository & Tracker - Toko ASMD</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#0369a1',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- 1. TOP HEADER / NAVIGATION BAR -->
    <header class="bg-slate-900 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-brand-500 text-white p-2 rounded-lg">
                    <i class="fa-solid fa-boxes-stacked text-xl"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight tracking-wide">SBC REPOSITORY & TRACKER</h1>
                    <p class="text-xs text-slate-400">Partial Stock Check System - Toko ASMD</p>
                </div>
            </div>

            <div class="flex items-center space-x-3">
                <!-- Dropdown Select Toko -->
                <div class="relative">
                    <select id="storeSelect" class="bg-slate-800 text-xs font-semibold text-slate-200 border border-slate-700 rounded-lg px-3 py-2 pr-8 focus:outline-none focus:ring-2 focus:ring-brand-500 cursor-pointer">
                        <option value="ASMD" selected>Toko ASMD (Active)</option>
                        <option value="CAB_B" disabled>Toko Cabang B (Coming Soon)</option>
                        <option value="CAB_C" disabled>Toko Cabang C (Coming Soon)</option>
                    </select>
                </div>

                <!-- Tombol Sync Data -->
                <button id="btnSync" onclick="fetchSheetData()" class="bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold px-3 py-2 rounded-lg transition-all duration-200 flex items-center space-x-2 shadow-sm active:scale-95">
                    <i class="fa-solid fa-rotate" id="syncIcon"></i>
                    <span class="hidden sm:inline">Sync Data Spreadsheet</span>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">
        
        <!-- Status Sync Alert -->
        <div id="syncStatusAlert" class="hidden mb-4 p-3 rounded-lg text-xs font-medium flex items-center justify-between">
            <span id="syncStatusText"></span>
            <button onclick="document.getElementById('syncStatusAlert').classList.add('hidden')" class="text-slate-500 hover:text-slate-700">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- 2. DASHBOARD METRICS (KPI CARDS) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <!-- Metric 1: Total SKU -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total SKU</p>
                    <h3 id="cardTotalSku" class="text-2xl font-bold text-slate-800 mt-1">0</h3>
                    <p class="text-[10px] text-slate-400 mt-0.5">Item terdaftar di area</p>
                </div>
                <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl">
                    <i class="fa-solid fa-barcode"></i>
                </div>
            </div>

            <!-- Metric 2: Progres Checking -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Progres Checking</p>
                        <h3 id="cardProgressPercent" class="text-2xl font-bold text-slate-800 mt-1">0%</h3>
                    </div>
                    <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="flex justify-between text-[11px] text-slate-500 mb-1">
                        <span id="cardProgressCount">0 / 0 SKU</span>
                        <span id="cardProgressText">0%</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                        <div id="progressBar" class="bg-indigo-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Metric 3: Akurasi SBC -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Akurasi SBC</p>
                    <h3 id="cardAccuracy" class="text-2xl font-bold text-emerald-600 mt-1">0%</h3>
                    <p class="text-[10px] text-slate-400 mt-0.5">Dari barang yang sudah dicek</p>
                </div>
                <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl">
                    <i class="fa-solid fa-bullseye"></i>
                </div>
            </div>

            <!-- Metric 4: Total Variance -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Variance</p>
                    <h3 id="cardTotalVariance" class="text-2xl font-bold text-slate-800 mt-1">0 <span class="text-xs font-normal">Pcs</span></h3>
                    <p id="cardVarianceDetail" class="text-[10px] text-slate-400 mt-0.5">Selisih Fisik - Sistem</p>
                </div>
                <div id="cardVarianceIconBg" class="w-12 h-12 bg-slate-50 text-slate-600 rounded-xl flex items-center justify-center text-xl">
                    <i id="cardVarianceIcon" class="fa-solid fa-scale-balanced"></i>
                </div>
            </div>
        </div>

        <!-- 3. CONTROLS & FILTER BAR -->
        <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
                <!-- Search / Scanner Input -->
                <div class="md:col-span-5 relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" id="searchInput" oninput="applyFilters()" placeholder="Scan Barcode / Cari SKU, Deskripsi, Alamat Rak..." class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white transition-all">
                </div>

                <!-- Filter Area / Rak -->
                <div class="md:col-span-3">
                    <select id="filterArea" onchange="applyFilters()" class="w-full py-2 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500 cursor-pointer">
                        <option value="ALL">Semua Area / Rak</option>
                        <!-- Dynamic options will be populated by JavaScript -->
                    </select>
                </div>

                <!-- Filter Status Variance -->
                <div class="md:col-span-2">
                    <select id="filterStatus" onchange="applyFilters()" class="w-full py-2 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500 cursor-pointer">
                        <option value="ALL">Semua Status</option>
                        <option value="MINUS">Selisih Minus (-)</option>
                        <option value="PLUS">Selisih Plus (+)</option>
                        <option value="MATCH">Sesuai / Pass (0)</option>
                        <option value="UNCHECKED">Belum Dicek</option>
                    </select>
                </div>

                <!-- Tombol Export CSV -->
                <div class="md:col-span-2">
                    <button onclick="exportToCSV()" class="w-full bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold py-2 px-3 rounded-lg transition-all flex items-center justify-center space-x-2 shadow-sm">
                        <i class="fa-solid fa-file-csv"></i>
                        <span>Export CSV</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- 4. LEMBAR KERJA / TABLE DATA (WORKSPACES) -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-100 text-slate-600 text-[11px] font-bold uppercase tracking-wider border-b border-slate-200">
                            <th class="py-3 px-3 text-center w-12">No</th>
                            <th class="py-3 px-3">SKU</th>
                            <th class="py-3 px-3 min-w-[200px]">Deskripsi Produk</th>
                            <th class="py-3 px-3">Alamat</th>
                            <th class="py-3 px-3 text-right">Price</th>
                            <th class="py-3 px-3 text-center">KS</th>
                            <th class="py-3 px-3 text-right">SYS</th>
                            <th class="py-3 px-3 text-center w-28">PHY</th>
                            <th class="py-3 px-3 text-right">VAR</th>
                            <th class="py-3 px-3 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody id="inventoryTableBody" class="divide-y divide-slate-200 text-xs text-slate-700">
                        <!-- Table rows populated dynamically via JS -->
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="hidden p-8 text-center">
                <i class="fa-solid fa-box-open text-4xl text-slate-300 mb-2"></i>
                <p class="text-sm font-medium text-slate-500">Tidak ada data SKU yang cocok dengan filter.</p>
            </div>
        </div>

    </main>

    <footer class="bg-white border-t border-slate-200 py-4 mt-auto">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
            &copy; 2026 SBC Partial Store System &bull; Toko ASMD Operations
        </div>
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // SPREADSHEET CONFIG
        const SPREADSHEET_ID = '1Ft7xFLiaHN5KDNZxBvrmsOl_o2K2UhMn0B21tPB8V70';
        
        // SAMPLE FALLBACK DATA
        const fallbackData = [
            { no: 1, sku: '20010921', desc: 'SGM EKSPLOR 1+ MADU 900G', alamat: 'AG01-01', price: 92500, ks: 'T', sys: 24, phy: null, area: 'AG01 / Gondola Promo' },
            { no: 2, sku: '20010922', desc: 'SGM EKSPLOR 3+ VANILA 900G', alamat: 'AG01-02', price: 89000, ks: 'T', sys: 18, phy: 18, area: 'AG01 / Gondola Promo' },
            { no: 3, sku: '20054110', desc: 'INDOMIE GORENG SPESIAL 85G', alamat: 'AG01-03', price: 3100, ks: 'Y', sys: 120, phy: 115, area: 'AG01 / Gondola Promo' },
            { no: 4, sku: '10087723', desc: 'PILOT PULPEN G2 BLACK 0.5', alamat: 'ST-01-A', price: 18500, ks: 'T', sys: 15, phy: 15, area: 'Stationery' },
            { no: 5, sku: '10087724', desc: 'JOYKO BINDER CLIP 107', alamat: 'ST-01-B', price: 6500, ks: 'T', sys: 30, phy: 32, area: 'Stationery' },
            { no: 6, sku: '30012290', desc: 'MINYAK GORENG SANIA 2L', alamat: 'KS-01-01', price: 34500, ks: 'Y', sys: 50, phy: null, area: 'KS' },
            { no: 7, sku: '40098112', desc: 'KERUPUK UDANG NY. SIAN 250G', alamat: 'OL-02-A', price: 22000, ks: 'T', sys: 10, phy: 8, area: 'Olahan Nusantara' },
            { no: 8, sku: '50011200', desc: 'KANTONG PLASTIK KASIR L', alamat: 'KASIR-01', price: 500, ks: 'Y', sys: 500, phy: 500, area: 'Kasir' }
        ];

        let masterData = [];
        let filteredData = [];

        // INITIALIZATION
        document.addEventListener('DOMContentLoaded', () => {
            fetchSheetData();
        });

        // FETCH DATA FROM GOOGLE SHEET (GVIZ API) WITH FALLBACK
        async function fetchSheetData() {
            const syncIcon = document.getElementById('syncIcon');
            syncIcon.classList.add('fa-spin');
            showStatusAlert('Mengambil data terbaru dari Google Spreadsheet...', 'bg-blue-50 text-blue-700 border border-blue-200');

            const gvizUrl = `https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}/gviz/tq?tqx=out:json`;

            try {
                const response = await fetch(gvizUrl);
                if (!response.ok) throw new Error('Network response was not ok');
                const text = await response.text();
                
                // Parse GViz JSON Response
                const jsonText = text.substring(47, text.length - 2);
                const json = JSON.parse(jsonText);
                
                if (json.table && json.table.rows) {
                    masterData = parseGvizRows(json.table.rows);
                    showStatusAlert('Berhasil menyinkronkan data dari Google Spreadsheet.', 'bg-emerald-50 text-emerald-700 border border-emerald-200');
                } else {
                    throw new Error('Format data tidak valid');
                }
            } catch (error) {
                console.warn('Gagal fetch data Google Sheet, menggunakan Fallback Data:', error);
                masterData = JSON.parse(JSON.stringify(fallbackData)); // Deep copy
                showStatusAlert('Gagal terhubung ke Google Sheet. Menggunakan Offline Fallback Data.', 'bg-amber-50 text-amber-700 border border-amber-200');
            } finally {
                syncIcon.classList.remove('fa-spin');
                populateAreaFilter();
                applyFilters();
            }
        }

        // PARSE GVIZ ROWS TO OBJECT ARRAY
        function parseGvizRows(rows) {
            const parsed = [];
            rows.forEach((row, index) => {
                const c = row.c;
                if (!c || c.length === 0 || !c[1]) return; // Skip if empty or no SKU

                const sku = c[1] ? String(c[1].v || '') : '';
                const desc = c[2] ? String(c[2].v || '') : '';
                const alamat = c[3] ? String(c[3].v || '') : '-';
                const price = c[4] ? Number(c[4].v || 0) : 0;
                const ks = c[5] ? String(c[5].v || 'T') : 'T';
                const sys = c[6] ? Number(c[6].v || 0) : 0;
                const phyVal = (c[7] && c[7].v !== null && c[7].v !== undefined) ? Number(c[7].v) : null;
                const area = c[10] ? String(c[10].v || '') : extractAreaFromAlamat(alamat);

                parsed.push({
                    no: index + 1,
                    sku: sku,
                    desc: desc,
                    alamat: alamat,
                    price: price,
                    ks: ks,
                    sys: sys,
                    phy: phyVal,
                    area: area || 'Lainnya'
                });
            });
            return parsed.length > 0 ? parsed : JSON.parse(JSON.stringify(fallbackData));
        }

        function extractAreaFromAlamat(alamat) {
            if (alamat.startsWith('AG')) return 'AG01 / Gondola Promo';
            if (alamat.startsWith('ST')) return 'Stationery';
            if (alamat.startsWith('KS')) return 'KS';
            if (alamat.startsWith('OL')) return 'Olahan Nusantara';
            if (alamat.startsWith('KASIR')) return 'Kasir';
            return 'Area Umum';
        }

        // POPULATE AREA FILTER DROPDOWN
        function populateAreaFilter() {
            const filterArea = document.getElementById('filterArea');
            const areas = [...new Set(masterData.map(item => item.area))].filter(Boolean);
            
            // Simpan selection jika ada
            const currentVal = filterArea.value;

            filterArea.innerHTML = '<option value="ALL">Semua Area / Rak</option>';
            areas.forEach(area => {
                const opt = document.createElement('option');
                opt.value = area;
                opt.textContent = area;
                filterArea.appendChild(opt);
            });

            if (areas.includes(currentVal)) {
                filterArea.value = currentVal;
            }
        }

        // APPLY FILTERS (SEARCH, AREA, STATUS)
        function applyFilters() {
            const searchValue = document.getElementById('searchInput').value.toLowerCase().trim();
            const areaValue = document.getElementById('filterArea').value;
            const statusValue = document.getElementById('filterStatus').value;

            filteredData = masterData.filter(item => {
                // Search filter
                const matchSearch = item.sku.toLowerCase().includes(searchValue) ||
                                    item.desc.toLowerCase().includes(searchValue) ||
                                    item.alamat.toLowerCase().includes(searchValue);

                // Area filter
                const matchArea = (areaValue === 'ALL') || (item.area === areaValue);

                // Status filter
                let matchStatus = true;
                const varVal = item.phy !== null ? (item.phy - item.sys) : null;

                if (statusValue === 'MINUS') {
                    matchStatus = item.phy !== null && varVal < 0;
                } else if (statusValue === 'PLUS') {
                    matchStatus = item.phy !== null && varVal > 0;
                } else if (statusValue === 'MATCH') {
                    matchStatus = item.phy !== null && varVal === 0;
                } else if (statusValue === 'UNCHECKED') {
                    matchStatus = item.phy === null;
                }

                return matchSearch && matchArea && matchStatus;
            });

            renderTable();
            calculateMetrics();
        }

        // RENDER TABLE
        function renderTable() {
            const tbody = document.getElementById('inventoryTableBody');
            const emptyState = document.getElementById('emptyState');
            tbody.innerHTML = '';

            if (filteredData.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            filteredData.forEach((item, index) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition-colors border-b border-slate-100";

                const isChecked = item.phy !== null;
                const variance = isChecked ? (item.phy - item.sys) : 0;
                
                // Status Badge Calculation
                let badgeHtml = '';
                if (!isChecked) {
                    badgeHtml = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-600"><i class="fa-solid fa-circle text-[6px] mr-1 text-slate-400"></i>Belum Cek</span>`;
                } else if (variance === 0) {
                    badgeHtml = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-800"><i class="fa-solid fa-check text-[8px] mr-1"></i>Akurat</span>`;
                } else if (variance < 0) {
                    badgeHtml = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-100 text-rose-800"><i class="fa-solid fa-minus text-[8px] mr-1"></i>Minus (${variance})</span>`;
                } else {
                    badgeHtml = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-100 text-amber-800"><i class="fa-solid fa-plus text-[8px] mr-1"></i>Plus (+${variance})</span>`;
                }

                // Format Price
                const formattedPrice = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(item.price);

                // Variance Class text color
                let varColorClass = 'text-slate-400';
                if (isChecked) {
                    if (variance === 0) varColorClass = 'text-emerald-600 font-bold';
                    else if (variance < 0) varColorClass = 'text-rose-600 font-bold';
                    else varColorClass = 'text-amber-600 font-bold';
                }

                tr.innerHTML = `
                    <td class="py-2.5 px-3 text-center text-slate-400 font-mono">${index + 1}</td>
                    <td class="py-2.5 px-3 font-mono font-bold text-slate-900">${item.sku}</td>
                    <td class="py-2.5 px-3 font-medium text-slate-800">${item.desc}</td>
                    <td class="py-2.5 px-3 font-mono text-slate-500">${item.alamat}</td>
                    <td class="py-2.5 px-3 text-right text-slate-600 font-mono">${formattedPrice}</td>
                    <td class="py-2.5 px-3 text-center">
                        <span class="px-1.5 py-0.5 text-[10px] font-semibold rounded ${item.ks === 'Y' ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' : 'text-slate-400'}">${item.ks}</span>
                    </td>
                    <td class="py-2.5 px-3 text-right font-mono font-semibold text-slate-700">${item.sys}</td>
                    <td class="py-2.5 px-3 text-center">
                        <input type="number" min="0" 
                            value="${item.phy !== null ? item.phy : ''}" 
                            placeholder="-"
                            oninput="updatePhysicalQty('${item.sku}', this.value)"
                            class="w-20 text-center font-mono font-bold py-1 px-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all ${isChecked ? 'bg-white border-slate-300 text-slate-900' : 'bg-slate-50 border-slate-200 text-slate-400'}"
                        />
                    </td>
                    <td class="py-2.5 px-3 text-right font-mono ${varColorClass}">
                        ${isChecked ? (variance > 0 ? '+' + variance : variance) : '-'}
                    </td>
                    <td class="py-2.5 px-3 text-center">${badgeHtml}</td>
                `;

                tbody.appendChild(tr);
            });
        }

        // UPDATE PHYSICAL QTY & REALTIME RECALCULATE
        function updatePhysicalQty(sku, value) {
            const item = masterData.find(d => d.sku === sku);
            if (item) {
                item.phy = value !== '' ? parseInt(value, 10) : null;
                
                // Partial update UI agar halus tanpa reset focus input jika mengetik
                calculateMetrics();
                
                // Cari row terkait di DOM untuk update VAR & Status Badge tanpa re-render total tabel
                const trs = document.querySelectorAll('#inventoryTableBody tr');
                trs.forEach(tr => {
                    if (tr.children[1] && tr.children[1].innerText === sku) {
                        const isChecked = item.phy !== null;
                        const variance = isChecked ? (item.phy - item.sys) : 0;
                        const varTd = tr.children[8];
                        const statusTd = tr.children[9];

                        if (!isChecked) {
                            varTd.className = "py-2.5 px-3 text-right font-mono text-slate-400";
                            varTd.innerText = "-";
                            statusTd.innerHTML = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-600"><i class="fa-solid fa-circle text-[6px] mr-1 text-slate-400"></i>Belum Cek</span>`;
                        } else {
                            if (variance === 0) {
                                varTd.className = "py-2.5 px-3 text-right font-mono text-emerald-600 font-bold";
                                varTd.innerText = "0";
                                statusTd.innerHTML = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-800"><i class="fa-solid fa-check text-[8px] mr-1"></i>Akurat</span>`;
                            } else if (variance < 0) {
                                varTd.className = "py-2.5 px-3 text-right font-mono text-rose-600 font-bold";
                                varTd.innerText = variance;
                                statusTd.innerHTML = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-100 text-rose-800"><i class="fa-solid fa-minus text-[8px] mr-1"></i>Minus (${variance})</span>`;
                            } else {
                                varTd.className = "py-2.5 px-3 text-right font-mono text-amber-600 font-bold";
                                varTd.innerText = "+" + variance;
                                statusTd.innerHTML = `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-100 text-amber-800"><i class="fa-solid fa-plus text-[8px] mr-1"></i>Plus (+${variance})</span>`;
                            }
                        }
                    }
                });
            }
        }

        // CALCULATE DASHBOARD METRICS
        function calculateMetrics() {
            // Kalkulasi berdasarkan data terpilih/filteredData
            const totalSku = filteredData.length;
            const checkedItems = filteredData.filter(d => d.phy !== null);
            const totalChecked = checkedItems.length;

            // Progres Checking
            const progressPercent = totalSku > 0 ? Math.round((totalChecked / totalSku) * 100) : 0;

            // Akurasi SBC (% SKU dengan selisih 0 dari barang yang SUDAH dicek)
            const accurateItems = checkedItems.filter(d => (d.phy - d.sys) === 0);
            const accuracyPercent = totalChecked > 0 ? Math.round((accurateItems.length / totalChecked) * 100) : 0;

            // Total Variance (Pcs)
            const totalVariance = checkedItems.reduce((acc, curr) => acc + (curr.phy - curr.sys), 0);

            // Update UI Dashboard Cards
            document.getElementById('cardTotalSku').innerText = totalSku;
            document.getElementById('cardProgressPercent').innerText = `${progressPercent}%`;
            document.getElementById('cardProgressCount').innerText = `${totalChecked} / ${totalSku} SKU`;
            document.getElementById('cardProgressText').innerText = `${progressPercent}%`;
            document.getElementById('progressBar').style.width = `${progressPercent}%`;

            document.getElementById('cardAccuracy').innerText = `${accuracyPercent}%`;

            const cardVariance = document.getElementById('cardTotalVariance');
            const cardVarDetail = document.getElementById('cardVarianceDetail');
            const iconBg = document.getElementById('cardVarianceIconBg');
            const icon = document.getElementById('cardVarianceIcon');

            if (totalVariance < 0) {
                cardVariance.className = "text-2xl font-bold text-rose-600 mt-1";
                cardVariance.innerHTML = `${totalVariance} <span class="text-xs font-normal">Pcs</span>`;
                cardVarDetail.innerText = "Defisit / Barang Hilang";
                iconBg.className = "w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center text-xl";
                icon.className = "fa-solid fa-arrow-trend-down";
            } else if (totalVariance > 0) {
                cardVariance.className = "text-2xl font-bold text-amber-600 mt-1";
                cardVariance.innerHTML = `+${totalVariance} <span class="text-xs font-normal">Pcs</span>`;
                cardVarDetail.innerText = "Surplus / Lebih Catat";
                iconBg.className = "w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-xl";
                icon.className = "fa-solid fa-arrow-trend-up";
            } else {
                cardVariance.className = "text-2xl font-bold text-emerald-600 mt-1";
                cardVariance.innerHTML = `0 <span class="text-xs font-normal">Pcs</span>`;
                cardVarDetail.innerText = "Sesuai / Balance";
                iconBg.className = "w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl";
                icon.className = "fa-solid fa-check-double";
            }
        }

        // EXPORT FILTERED DATA TO CSV
        function exportToCSV() {
            if (filteredData.length === 0) {
                alert('Tidak ada data untuk diexport.');
                return;
            }

            const headers = ['NO', 'SKU', 'DESKRIPSI', 'ALAMAT', 'HARGA', 'KS', 'QTY_SYS', 'QTY_PHY', 'VARIANCE', 'STATUS', 'AREA'];
            const rows = filteredData.map((d, i) => {
                const isChecked = d.phy !== null;
                const variance = isChecked ? (d.phy - d.sys) : '';
                let status = 'Belum Cek';
                if (isChecked) {
                    if (variance === 0) status = 'Akurat';
                    else if (variance < 0) status = 'Selisih Minus';
                    else status = 'Selisih Plus';
                }

                return [
                    i + 1,
                    `"${d.sku}"`,
                    `"${d.desc.replace(/"/g, '""')}"`,
                    `"${d.alamat}"`,
                    d.price,
                    d.ks,
                    d.sys,
                    d.phy !== null ? d.phy : '',
                    variance,
                    status,
                    `"${d.area}"`
                ];
            });

            let csvContent = 'data:text/csv;charset=utf-8,' 
                + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement('a');
            link.setAttribute('href', encodedUri);
            const dateStr = new Date().toISOString().slice(0,10);
            link.setAttribute('download', `SBC_Partial_ASMD_${dateStr}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // ALERT HELPER
        function showStatusAlert(msg, colorClass) {
            const alertBox = document.getElementById('syncStatusAlert');
            const alertText = document.getElementById('syncStatusText');
            alertBox.className = `mb-4 p-3 rounded-lg text-xs font-medium flex items-center justify-between ${colorClass}`;
            alertText.innerText = msg;
            alertBox.classList.remove('hidden');

            setTimeout(() => {
                alertBox.classList.add('hidden');
            }, 5000);
        }
    </script>
